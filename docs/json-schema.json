{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "go-mapi Message Format",
  "description": "JSON format for email messages captured by the go-mapi interceptor",
  "type": "object",
  "required": ["version", "timestamp", "subject", "body", "bodyFormat", "recipients", "attachments", "originApp"],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Schema version number",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp when the message was captured",
      "format": "date-time"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "body": {
      "type": "string",
      "description": "Email body content"
    },
    "bodyFormat": {
      "type": "string",
      "description": "Email body format",
      "enum": ["plain", "html"]
    },
    "recipients": {
      "type": "object",
      "description": "Email recipients grouped by type",
      "required": ["to", "cc", "bcc"],
      "properties": {
        "to": {
          "type": "array",
          "description": "To recipients",
          "items": {
            "type": "object",
            "required": ["name", "address"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Recipient display name"
              },
              "address": {
                "type": "string",
                "description": "Recipient email address"
              }
            }
          }
        },
        "cc": {
          "type": "array",
          "description": "CC recipients",
          "items": {
            "type": "object",
            "required": ["name", "address"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Recipient display name"
              },
              "address": {
                "type": "string",
                "description": "Recipient email address"
              }
            }
          }
        },
        "bcc": {
          "type": "array",
          "description": "BCC recipients",
          "items": {
            "type": "object",
            "required": ["name", "address"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Recipient display name"
              },
              "address": {
                "type": "string",
                "description": "Recipient email address"
              }
            }
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "description": "File attachments",
      "items": {
        "type": "object",
        "required": ["filename", "path", "size"],
        "properties": {
          "filename": {
            "type": "string",
            "description": "Attachment filename"
          },
          "path": {
            "type": "string",
            "description": "Full file system path to attachment"
          },
          "size": {
            "type": "integer",
            "description": "File size in bytes",
            "minimum": 0
          }
        }
      }
    },
    "originApp": {
      "type": "string",
      "description": "Name of the application that initiated the send (e.g., 'explorer.exe')"
    }
  }
}
